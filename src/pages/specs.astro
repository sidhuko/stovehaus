---
import Base from '../layouts/Base.astro';
import LineChip from '../components/LineChip.astro';
import ProvisionalNote from '../components/ProvisionalNote.astro';
import { PRODUCTS, LINES, getLine } from '../data/products';
import { CERTIFICATION_STATUS } from '../data/site';

const published = PRODUCTS.filter((p) => p.status === 'published');
const cell = (p: (typeof PRODUCTS)[number], label: string) =>
  p.specs?.find((s) => s.label === label)?.value.split('(')[0].trim() ?? '—';

/*
  The model code convention as proposed in the guidelines (p.9). Shown here so a
  dealer can read a code off a crate or an etched plate, even while our own
  catalogue has not adopted it yet — see BRAND.md open items on naming.
*/
const CODE_PARTS = [
  ['SH', 'Stovehaus'],
  ['SN / JZ / FP', 'Line — sauna, jacuzzi, fire pit'],
  ['16', 'Output in kW'],
  ['CS / BK', 'Finish — corten steel, black'],
];
---

<Base
  title="Specs"
  description="The full Versa ladder, model codes and certification status for the Stovehaus catalogue."
>
  <section class="mx-auto max-w-7xl px-6 lg:px-10 pt-16">
    <p class="eyebrow text-steel">Specifications</p>
    <h1 class="display-1 mt-5 text-ink max-w-3xl">Say the number.</h1>
    <p class="lede mt-6 text-ink-muted max-w-2xl">
      Buyers choose on output, room volume, heat-up time and steel thickness. Everything we have is
      on this page, and everything that is still a target rather than a measurement says so.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
    <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-hairline pb-4">
      <h2 class="display-3 text-ink">The Versa ladder</h2>
      <p class="spec text-steel">{published.length} models</p>
    </div>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-205 border-collapse">
        <thead>
          <tr class="border-b border-hairline">
            <th class="eyebrow text-steel text-left py-3 pr-6">Line</th>
            <th class="eyebrow text-steel text-left py-3 pr-6">Model</th>
            <th class="eyebrow text-steel text-left py-3 pr-6">Model code</th>
            <th class="eyebrow text-steel text-right py-3 pr-6">Output</th>
            <th class="eyebrow text-steel text-right py-3 pr-6">Room volume</th>
            <th class="eyebrow text-steel text-right py-3 pr-6">Stones</th>
            <th class="eyebrow text-steel text-right py-3">Flue</th>
          </tr>
        </thead>
        <tbody>
          {
            published.map((product) => (
              <tr class="border-b border-hairline">
                <td class="py-4 pr-6">
                  <LineChip line={getLine(product.line)} />
                </td>
                <td class="py-4 pr-6">
                  <a href={`/${product.line}/${product.slug}`} class="label link">
                    {product.name}
                  </a>
                </td>
                <td class="spec text-steel py-4 pr-6">{product.modelCode ?? 'Pending'}</td>
                <td class="spec text-ink text-right py-4 pr-6">
                  {product.headlineFigure
                    ? `${product.headlineFigure.value} ${product.headlineFigure.unit}`
                    : '—'}
                </td>
                <td class="spec text-ink text-right py-4 pr-6">{cell(product, 'Room volume')}</td>
                <td class="spec text-ink text-right py-4 pr-6">{cell(product, 'Heater stones')}</td>
                <td class="spec text-ink text-right py-4">{cell(product, 'Flue diameter')}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-10 max-w-3xl">
      <ProvisionalNote variant="panel" />
    </div>

    {/* The other two lines are not a table — they have nothing to tabulate. */}
    <div class="mt-12 grid gap-px bg-hairline sm:grid-cols-2 border border-hairline max-w-3xl">
      {
        LINES.filter((l) => l.status !== 'available').map((l) => (
          <div class="bg-surface-100 p-7">
            <LineChip line={l} />
            <p class="label mt-4 text-ink">
              {l.status === 'coming-soon' ? 'Coming soon' : 'Built to order'}
            </p>
            <p class="body-copy mt-2 text-ink-muted">
              {l.status === 'coming-soon'
                ? 'In development. No figures published until they have been measured.'
                : 'No catalogue — each one is cut to the opening it drops into.'}
            </p>
            <a href={`/${l.id}`} class="link body-copy mt-4 inline-block">
              {l.name}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 lg:px-10 pb-16">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20 items-start">
      <div>
        <h2 class="display-3 text-ink">Reading a model code</h2>
        <p class="body-copy mt-4 text-ink-muted">
          The code is stamped on the etched plate and stencilled on the crate. It reads
          <span class="spec">SH – line – output – finish</span>.
        </p>
        <dl class="mt-8 border-t border-hairline">
          {
            CODE_PARTS.map(([code, meaning]) => (
              <div class="grid grid-cols-[auto_1fr] gap-6 py-3.5 border-b border-hairline">
                <dt class="spec text-ink">{code}</dt>
                <dd class="body-copy text-ink-muted text-right">{meaning}</dd>
              </div>
            ))
          }
        </dl>
        <p class="body-copy mt-5 text-ink-faint">
          Example: <span class="spec">SH-SN-16-CS</span> would be a sauna heater, 17 kW, corten
          steel. No codes are assigned to the Versa line yet.
        </p>
      </div>

      <div>
        <h2 class="display-3 text-ink">Units</h2>
        <p class="body-copy mt-4 text-ink-muted">
          Anything crossing the border is given metric first with imperial in parentheses, on every
          dimension. Sauna heaters are rated on room <em>volume</em> in m³, not floor area — a room
          with a high ceiling needs more stove than its footprint suggests.
        </p>

        <div class="mt-8 border border-hairline bg-gold-wash p-8">
          <p class="eyebrow text-gold-deep">Certification</p>
          <p class="body-copy mt-3 text-ink">{CERTIFICATION_STATUS.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 lg:px-10 pb-8">
    <div class="rule-gold pt-8 flex flex-wrap items-baseline justify-between gap-5">
      <p class="display-3 text-ink max-w-xl">Need a figure that is not here?</p>
      <a href="/quote" class="btn-gold bx-press bx-liquid">Request a quote</a>
    </div>
  </section>
</Base>
