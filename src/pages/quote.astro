---
import Base from '../layouts/Base.astro';
import { SITE, CERTIFICATION_STATUS } from '../data/site';
import { LINES } from '../data/products';

/*
  Static form. There is no backend on this pass — the form posts nowhere and the
  page says so, rather than pretending to submit and dropping the enquiry.
  Wiring it up is a later task; the phone number and email address on this page
  work today.

  The audience selector is first because the two readers need different things
  from us, and asking once saves a round trip.
*/
---

<Base
  title="Request a quote"
  description="Request a quote or specifications for Stovehaus sauna heaters, jacuzzi heaters and gas fire pits."
>
  <section class="mx-auto max-w-7xl px-6 lg:px-10 pt-16">
    <p class="eyebrow text-steel">Get in touch</p>
    <h1 class="display-1 mt-5 text-ink max-w-3xl">Request a quote.</h1>
    <p class="lede mt-6 text-ink-muted max-w-2xl">
      Tell us what you are building or stocking and we will come back with figures — incoterm,
      currency, validity, lead time and HS code included.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:gap-16 items-start">
      <form class="border border-hairline bg-surface-100 p-8 lg:p-10" novalidate>
        <fieldset class="border-0 p-0 m-0">
          <legend class="eyebrow text-steel">Who you are</legend>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {
              [
                ['dealer', 'Dealer or installer'],
                ['buyer', 'Property owner'],
              ].map(([value, label], i) => (
                <label class="flex items-center gap-3 border border-hairline bg-surface-200 px-4 py-3 cursor-pointer has-[:checked]:border-edge">
                  <input
                    type="radio"
                    name="audience"
                    value={value}
                    checked={i === 0}
                    class="accent-[#7D5C0F]"
                  />
                  <span class="label font-normal text-ink">{label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="border-0 p-0 m-0 mt-8">
          <legend class="eyebrow text-steel">What you are asking about</legend>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            {
              LINES.map((line) => (
                <label class="flex items-center gap-3 border border-hairline bg-surface-200 px-4 py-3 cursor-pointer has-[:checked]:border-edge">
                  <input
                    type="checkbox"
                    name="line"
                    value={line.id}
                    class="accent-[#7D5C0F]"
                  />
                  <span class="label font-normal text-ink">{line.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="eyebrow text-steel">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              class="mt-2.5 w-full border border-hairline bg-surface-300 px-4 py-3 body-copy text-ink focus:border-edge"
            />
          </div>
          <div>
            <label for="company" class="eyebrow text-steel">Company</label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              class="mt-2.5 w-full border border-hairline bg-surface-300 px-4 py-3 body-copy text-ink focus:border-edge"
            />
          </div>
          <div>
            <label for="email" class="eyebrow text-steel">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              class="mt-2.5 w-full border border-hairline bg-surface-300 px-4 py-3 body-copy text-ink focus:border-edge"
            />
          </div>
          <div>
            <label for="location" class="eyebrow text-steel">Ship-to city and country</label>
            <input
              id="location"
              name="location"
              type="text"
              class="mt-2.5 w-full border border-hairline bg-surface-300 px-4 py-3 body-copy text-ink focus:border-edge"
            />
          </div>
        </div>

        <div class="mt-5">
          <label for="message" class="eyebrow text-steel">What you need</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            class="mt-2.5 w-full border border-hairline bg-surface-300 px-4 py-3 body-copy text-ink focus:border-edge"
          ></textarea>
        </div>

        <button type="submit" class="btn-gold bx-press bx-liquid mt-8 cursor-pointer">Send request</button>

        <p class="body-copy mt-5 text-ink-faint">
          This form is not connected yet. Until it is, call or email us directly — both reach the
          shop today.
        </p>
      </form>

      <aside>
        <div class="border border-hairline bg-surface-200 p-8">
          <p class="eyebrow text-steel">Direct</p>
          <ul class="mt-6 border-t border-hairline">
            <li class="py-3.5 border-b border-hairline">
              <a href={`tel:${SITE.phoneHref}`} class="spec link">{SITE.phone}</a>
            </li>
            <li class="py-3.5 border-b border-hairline">
              <a href={`mailto:${SITE.email}`} class="body-copy link">{SITE.email}</a>
            </li>
            <li class="py-3.5 border-b border-hairline">
              <span class="body-copy text-ink-muted">{SITE.domain}</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 border border-hairline bg-gold-wash p-8">
          <p class="eyebrow text-gold-deep">Before you ask</p>
          <p class="body-copy mt-3 text-ink">{CERTIFICATION_STATUS.text}</p>
        </div>

        <div class="mt-8 border border-hairline p-8">
          <p class="eyebrow text-steel">What comes back</p>
          <ul class="mt-6 border-t border-hairline">
            {
              ['Incoterm', 'Currency', 'Validity date', 'Lead time', 'HS code'].map((item) => (
                <li class="label font-normal text-ink-muted py-3 border-b border-hairline">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>
