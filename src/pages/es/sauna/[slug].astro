---
import ProductPage from '../../../components/pages/ProductPage.astro';
import { productsInLine, type Product } from '../../../data/products';

export function getStaticPaths() {
  return productsInLine('sauna')
    .filter((p) => p.status === 'published')
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product }
const { product } = Astro.props;
---
<ProductPage product={product} locale="es" />
