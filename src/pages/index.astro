---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AudienceFork from '../components/AudienceFork.astro';
import MessageBlock from '../components/MessageBlock.astro';
import LineChip from '../components/LineChip.astro';
import { SITE, MESSAGES } from '../data/site';
import { LINES, productsInLine } from '../data/products';

/* Each line says where it actually stands, rather than a count that would read
   as "0 of 3" on lines that were never going to have a model list. */
const STATUS_LABEL = {
  available: (n: number) => `${n} models`,
  'coming-soon': () => 'Coming soon',
  'made-to-order': () => 'Built to order',
} as const;

const lineSummary = LINES.map((line) => ({
  line,
  standing: STATUS_LABEL[line.status](
    productsInLine(line.id).filter((p) => p.status === 'published').length
  ),
}));
---

<Base title={SITE.name} path="/">
  <Hero
    eyebrow="Wood-fired · Made in Mexico"
    headline="Heavy steel, welded by hand."
    lede="Sauna heaters, jacuzzi heaters and gas fire pits, built in one shop and shipped north."
    image="jacuzzi-wood-fired.jpg"
    imageAlt="A cedar wood-fired hot tub in bare woodland, smoke rising from its flue, split logs stacked alongside."
    ctaHref="/sauna"
    ctaLabel="See the heaters"
    secondaryHref="/dealers"
    secondaryLabel="Dealer information"
  />

  {/* Three lines, three codes. */}
  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
    <div class="max-w-2xl">
      <h2 class="display-2 text-ink">Three lines.</h2>
      <p class="body-copy mt-4 text-ink-muted">
        Two burn wood and one burns gas. Each line is colour-coded throughout the site and the
        spec sheets, so you can tell at a glance which figure you are reading.
      </p>
    </div>

    <div class="mt-14 grid gap-px bg-hairline md:grid-cols-3 border border-hairline">
      {
        lineSummary.map(({ line, standing }) => (
          <a
            href={`/${line.id}`}
            class="group bg-surface-100 p-8 flex flex-col hover:bg-surface-200 transition-colors"
          >
            <LineChip line={line} class="self-start" />
            <h3 class="display-3 mt-5 text-ink">{line.name}</h3>
            <p class="body-copy mt-3 text-ink-muted">{line.lede}</p>
            <div class="mt-auto pt-8 flex items-baseline justify-between gap-4 border-t border-hairline">
              <span class="label text-ink-muted">Bought on {line.boughtOn}</span>
              <span class="spec text-steel">{standing}</span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="body-copy mt-6 text-ink-faint">
      The sauna line is the Versa ladder — six heaters from 15.4 to 20 kW. Its figures are design
      targets until we have fired each stove and measured it, and the site says so on every one.
      The jacuzzi line is in development, and the fire pits have no catalogue because each is cut
      to the opening it drops into.
    </p>
  </section>

  {/* The fork — dealers and end buyers, equally weighted. */}
  <AudienceFork />

  {/* Messages 01 and 02. Messages 03 and 04 carry the dealers page. */}
  <MessageBlock
    heading="Why it is built the way it is."
    messages={[MESSAGES[0], MESSAGES[1]]}
  />

  {/* Origin — a fact in a sentence, not a flag on a banner (guidelines p.8). */}
  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20 items-start">
      <div>
        <p class="eyebrow text-steel">The shop</p>
        <h2 class="display-2 mt-4 text-ink">Made in Mexico, shipped north.</h2>
        <p class="body-copy mt-5 text-ink-muted">
          Stovehaus designs and fabricates in Mexico for export to the United States and Canada.
          The short freight run north is the reason a dealer margin on this line works against a
          European import, and it is the reason a replacement part does not cross an ocean.
        </p>
        <p class="body-copy mt-4 text-ink-muted">
          Every stove is fired before it is crated. We load it, bring it to temperature and check
          the seams hot.
        </p>
        <a href="/shop" class="btn-outline mt-8">Inside the shop</a>
      </div>

      <div class="border border-hairline bg-surface-200 p-8 lg:p-10">
        <p class="eyebrow text-steel">What a dealer asks first</p>
        <dl class="mt-6 border-t border-hairline">
          {
            [
              ['Origin', 'Mexico'],
              ['Export markets', 'United States · Canada'],
              ['Documentation', 'Metric and imperial'],
              ['Certification', 'See dealers page'],
            ].map(([label, value]) => (
              <div class="grid grid-cols-[1fr_auto] gap-6 py-3.5 border-b border-hairline">
                <dt class="label font-normal text-ink-muted">{label}</dt>
                <dd class="spec text-ink text-right">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</Base>
