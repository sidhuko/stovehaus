---
import Base from '../layouts/Base.astro';
import MessageBlock from '../components/MessageBlock.astro';
import { MESSAGES, CERTIFICATION_STATUS, SITE } from '../data/site';

/*
  Messages 03 and 04 carry this page. The guidelines single out 04:
  "Message 04 is the one most often skipped and the one dealers actually need."

  Dealers decide on margin, lead time, freight, listings, and whether you will
  still be here in three years. None of those are numbers we hold yet, so this
  page names each one and says plainly that we will give the figure on request,
  rather than filling the gap with an adjective.
*/

const WHAT_DEALERS_ASK = [
  {
    label: 'Margin and terms',
    body: 'Dealer pricing, volume breaks and payment terms. Given in writing, per line.',
  },
  {
    label: 'Lead time',
    body: 'Working days from order to ready-to-ship, and what is on the floor now.',
  },
  {
    label: 'Freight',
    body: 'Incoterm, origin point and a landed estimate to your receiving address.',
  },
  {
    label: 'Listings and certification',
    body: 'Exactly where each line stands, stated as a status and a date — never implied.',
  },
  {
    label: 'Clearances and flue spec',
    body: 'What your installer needs to quote a job before the stove arrives.',
  },
  {
    label: 'Parts and warranty',
    body: 'Which parts are held on this continent, and what the warranty covers in writing.',
  },
];
---

<Base
  title="Dealers"
  description="Margin, lead time, freight, clearances and certification status for dealers and installers in the United States and Canada."
>
  <section class="mx-auto max-w-7xl px-6 lg:px-10 pt-16">
    <p class="eyebrow text-steel">For dealers and installers</p>
    <h1 class="display-1 mt-5 text-ink max-w-3xl">Carry the line.</h1>
    <p class="lede mt-6 text-ink-muted max-w-2xl">
      You are deciding whether to put this on a purchase order. Here is what you need to make that
      call, and what we will send you in writing.
    </p>
  </section>

  {/* Certification first — the thing most often skipped, per guidelines p.9. */}
  <section class="mx-auto max-w-7xl px-6 lg:px-10 pt-14">
    <div class="border border-hairline bg-gold-wash p-8 lg:p-10">
      <p class="eyebrow text-gold-deep">Certification status</p>
      <p class="lede mt-4 text-ink max-w-3xl">{CERTIFICATION_STATUS.text}</p>
      <p class="body-copy mt-4 text-ink-muted max-w-3xl">
        We would rather tell you a status and a date than let silence imply a listing that does not
        exist yet. Ask, and you will get the current position on each line.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
    <h2 class="display-2 text-ink">What we will send you</h2>
    <div class="mt-10 grid gap-px bg-hairline sm:grid-cols-2 lg:grid-cols-3 border border-hairline">
      {
        WHAT_DEALERS_ASK.map((item) => (
          <div class="bg-surface-100 p-7">
            <h3 class="label text-ink">{item.label}</h3>
            <p class="body-copy mt-2.5 text-ink-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
    <p class="body-copy mt-6 text-ink-faint">
      Figures are quoted per dealer and per line rather than published here, because a landed cost
      to Kelowna and a landed cost to Denver are not the same number.
    </p>
  </section>

  {/* Messages 03 and 04. */}
  <MessageBlock
    heading="The case for the line."
    messages={[MESSAGES[2], MESSAGES[3]]}
  />

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20 items-start">
      <div>
        <h2 class="display-2 text-ink">How a quote arrives</h2>
        <p class="body-copy mt-5 text-ink-muted">
          Often the first designed thing a dealer sees from us is an export quote, so it carries
          everything a broker will ask for. Nothing gets left off to make the page look tidier.
        </p>
        <a href="/quote" class="btn-gold mt-8">Request a quote</a>
      </div>

      <div class="border border-hairline bg-surface-200 p-8">
        <p class="eyebrow text-steel">Every quote carries</p>
        <ul class="mt-6 border-t border-hairline">
          {
            [
              'Incoterm',
              'Currency',
              'Validity date',
              'Lead time',
              'HS code',
              'Origin',
            ].map((item) => (
              <li class="label font-normal text-ink-muted py-3 border-b border-hairline">
                {item}
              </li>
            ))
          }
        </ul>
        <a href={`mailto:${SITE.email}`} class="body-copy link mt-6 inline-block">
          {SITE.email}
        </a>
      </div>
    </div>
  </section>
</Base>
