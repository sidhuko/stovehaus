---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MessageBlock from '../components/MessageBlock.astro';
import { MESSAGES } from '../data/site';
import { getImage } from '../data/images';

/*
  Message 02 carries this page: "One shop, one crew, every stove fired before
  it's crated."

  Voice rule from p.8: proud of where it's made, without ceremony — a fact in a
  sentence, not a flag on a banner. And Mexican fabrication is a craft story,
  not a cost story. The cost argument lives on the dealers page, where it is a
  margin argument and belongs.

  Rule 2 is the constraint that shapes this page: every claim carries a number
  or a name, or it gets cut. We have neither the crew's names nor shop figures
  yet, so this page describes process rather than asserting scale.

  The photography is Unsplash stock of metalwork, not of our floor. It shows
  the process honestly and never stands in for a Stovehaus stove — see
  CREDITS.md and the rules at the top of src/data/images.ts.
*/

const PROCESS = [
  {
    n: '01',
    title: 'Cut from plate',
    body: 'A firebox starts as flat steel on a bench, cut to a pattern and folded. Not a stamped shell pressed from thin stock.',
    image: 'shop-press-brake.jpg',
    alt: 'Gloved hands guiding a steel sheet through a press brake, the laser guide line visible along the bend.',
  },
  {
    n: '02',
    title: 'Seam-welded, then ground back',
    body: 'Seams are welded through, not tacked. The seam is the part that fails first on a stove fed hard for twenty years, so it is the part that gets the time.',
    image: 'shop-grinding-sparks.jpg',
    alt: 'An angle grinder throwing a spray of orange sparks off a steel plate on a bench.',
  },
  {
    n: '03',
    title: 'Fired before crating',
    body: 'Every stove is loaded, brought up to temperature and checked hot. A cold leak test tells you less than a hot one.',
  },
  {
    n: '04',
    title: 'Crated and shipped north',
    body: 'Stencilled, documented in metric and imperial, and freighted to the United States and Canada.',
  },
];

---

<Base
  title="The Shop"
  description="One shop, one crew. How a Stovehaus heater is cut, welded, fired and crated in Mexico."
>
  <Hero
    eyebrow="The shop · Made in Mexico"
    headline="One shop, one crew."
    lede="The people who weld the seams are the people who fire the stove before it is crated."
    image="shop-plate.jpg"
    imageAlt="A steel plate being worked on a press brake in a fabrication shop."
    imagePosition="center 55%"
    ctaHref="/sauna"
    ctaLabel="See the heaters"
  />

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
    <div class="max-w-2xl">
      <h2 class="display-2 text-ink">How one gets built.</h2>
      <p class="body-copy mt-4 text-ink-muted">
        Stovehaus fabricates in Mexico. That is a fact about how the work gets done, not a line in
        a pitch — it means a replacement part does not cross an ocean, and it means the freight run
        north is short enough that a dealer margin on this line works against a European import.
      </p>
    </div>

    <div class="mt-14 grid gap-px bg-hairline md:grid-cols-2 border border-hairline">
      {
        PROCESS.map((step) => {
          const photo = getImage(step.image);
          return (
            <div class="bg-surface-100 flex flex-col">
              {photo && (
                <Image
                  src={photo}
                  alt={step.alt ?? ''}
                  width={720}
                  height={420}
                  widths={[720, 1200]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="w-full aspect-7/4 object-cover border-b border-hairline"
                />
              )}
              <div class="p-8 lg:p-10">
                <p class="spec text-steel">{step.n}</p>
                <h3 class="display-3 mt-3 text-ink">{step.title}</h3>
                <p class="body-copy mt-3 text-ink-muted">{step.body}</p>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* Said plainly, because a dealer will ask and a buyer deserves to know. */}
    <p class="body-copy mt-6 text-ink-faint">
      The photographs on this page are stock images of metalwork, not of our floor. We will replace
      them with our own shop as soon as we have shot it, and we are not going to pass someone
      else's bench off as ours in the meantime.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-6 lg:px-10 pb-16">
    <div class="border border-hairline bg-surface-200 p-8 lg:p-12 max-w-3xl">
      <h2 class="display-3 text-ink">Why Mexico matters to a dealer</h2>
      <p class="body-copy mt-4 text-ink-muted">
        Two practical things follow from fabricating here rather than in Europe. The freight run
        north is short, which is what makes the margin on this line work against an import. And a
        replacement part does not cross an ocean to reach an installer with a job half finished.
      </p>
      <a href="/dealers" class="btn-outline mt-8">Dealer information</a>
    </div>
  </section>

  <MessageBlock messages={[MESSAGES[1], MESSAGES[0]]} />
</Base>
