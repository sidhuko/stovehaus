---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** 'inline' for a one-line marker, 'panel' for the full explanation. */
  variant?: 'inline' | 'panel';
}
const { locale, variant = 'inline' } = Astro.props;
const d = t(locale).provisional;

/*
  The Versa figures are the sizing ladder's design targets, not Stovehaus
  measurements. The guidelines are blunt about this — replace placeholders with
  tested specifications before anything is published or sent to a customer — so
  where we cannot yet do that, we say which kind of number a reader is looking
  at rather than letting it pass as measured. In both languages, identically.

  Steel, not ember: this is a status, not a figure, and the line colours are a
  code that stops working the moment they are spent on something else.
*/
---

{
  variant === 'inline' ? (
    <p class="spec text-steel">{d.inline}</p>
  ) : (
    <div class="border border-hairline bg-surface-200 p-8">
      <p class="eyebrow text-steel">{d.panelTitle}</p>
      <p class="body-copy mt-3 text-ink">{d.panelLead}</p>
      <p class="body-copy mt-4 text-ink-muted">{d.panelBody}</p>
    </div>
  )
}
