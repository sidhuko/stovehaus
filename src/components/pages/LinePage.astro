---
import Base from '../../layouts/Base.astro';
import Hero from '../Hero.astro';
import ProductCard from '../ProductCard.astro';
import ProvisionalNote from '../ProvisionalNote.astro';
import { getLine, productsInLine, type LineId } from '../../data/products';
import { t, localePath, type Locale } from '../../i18n';

interface Props {
  id: LineId;
  locale: Locale;
}

const { id, locale } = Astro.props;
const d = t(locale);
const copy = d.lines[id];
const line = getLine(id);
const products = productsInLine(id);
const published = products.filter((p) => p.status === 'published');
const hasTargetFigures = published.some((p) => p.basis === 'target');
---

<Base title={copy.name} route={`/${id}`} locale={locale} description={copy.lede}>
  <Hero
    eyebrow={copy.eyebrow}
    headline={copy.headline}
    lede={copy.lede}
    image={line.image}
    imageAlt={copy.imageAlt}
    imagePosition={line.imagePosition}
    ctaHref={localePath(locale, '/quote')}
    ctaLabel={line.status === 'coming-soon' ? d.common.askToBeToldFirst : d.common.requestQuote}
  />

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-20 items-start">
      <div>
        <h2 class="display-2 text-ink">{d.common.theLine}</h2>
        <p class="body-copy mt-5 text-ink-muted">{copy.intro}</p>
      </div>

      <div class="border border-hairline bg-surface-200 p-8">
        <p class="eyebrow text-steel">
          {line.status === 'made-to-order' ? d.common.specifiedOn : d.common.boughtOn}
        </p>
        <p class="display-3 mt-3 text-ink">{copy.boughtOn}</p>
        <dl class="mt-7 border-t border-hairline">
          {
            copy.buyingNotes.map((note) => (
              <div class="py-3.5 border-b border-hairline">
                <dt class="label font-normal text-ink-muted">{note.label}</dt>
                <dd class="body-copy mt-1.5 text-ink-faint">{note.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    {/* ── Models, or whatever stands in for them on this line ───────────── */}

    {
      line.status === 'available' && (
        <div class="mt-20">
          <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-hairline pb-4">
            <h2 class="display-3 text-ink">{d.common.models}</h2>
            <p class="spec text-steel">{d.linePage.modelsCount(published.length)}</p>
          </div>

          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {products.map((product) => (
              <ProductCard
                product={product}
                locale={locale}
                href={
                  product.status === 'published'
                    ? localePath(locale, `/${id}/${product.slug}`)
                    : undefined
                }
              />
            ))}
          </div>

          {hasTargetFigures && (
            <div class="mt-10">
              <ProvisionalNote locale={locale} variant="panel" />
            </div>
          )}
        </div>
      )
    }

    {
      line.status === 'coming-soon' && (
        /*
          Coming soon, and nothing more. No model slots, no placeholder
          figures, no date we cannot keep. Rule 2 of the voice: every claim
          carries a number or a name, and if neither is available, cut the
          claim. We do not have a date, so we do not print one.
        */
        <div class="mt-20 border border-hairline bg-surface-200 p-8 lg:p-12">
          <p class="eyebrow text-steel">{d.linePage.comingSoonEyebrow}</p>
          <h2 class="display-2 mt-4 text-ink max-w-2xl">
            {d.linePage.comingSoonTitle(copy.name)}
          </h2>
          <p class="lede mt-5 text-ink-muted max-w-2xl">{d.linePage.comingSoonLede}</p>
          <p class="body-copy mt-5 text-ink-muted">{d.linePage.comingSoonBody}</p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href={localePath(locale, '/quote')} class="btn-outline bx-press">
              {d.common.askToBeToldFirst}
            </a>
            <a href={localePath(locale, '/sauna')} class="btn-outline bx-press">
              {d.common.seeWhatIsShipping}
            </a>
          </div>
        </div>
      )
    }

    {
      line.status === 'made-to-order' && (
        /*
          No catalogue here. A linear burner is cut to the opening it drops
          into, so publishing "models" would be inventing SKUs for something
          that is dimensioned per job. The page asks for the four things we
          need instead.
        */
        <div class="mt-20">
          <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-hairline pb-4">
            <h2 class="display-3 text-ink">{d.linePage.builtToOrderNote}</h2>
            <p class="spec text-steel">{d.linePage.noCatalogue}</p>
          </div>

          <p class="body-copy mt-6 text-ink-muted">{d.linePage.builtToOrderBody}</p>

          <div class="mt-10 grid gap-px bg-hairline sm:grid-cols-2 border border-hairline">
            {d.firepitVariables.map((v, i) => (
              <div class="bg-surface-100 p-7">
                <p class="spec text-steel">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="label mt-3 text-ink">{v.label}</h3>
                <p class="body-copy mt-2.5 text-ink-muted">{v.body}</p>
              </div>
            ))}
          </div>

          <div class="mt-10 border border-hairline bg-surface-200 p-8 flex flex-wrap items-center justify-between gap-6">
            <p class="lede text-ink max-w-xl">{d.linePage.firepitCta}</p>
            <a href={localePath(locale, '/quote')} class="btn-outline bx-press">
              {d.common.startADrawing}
            </a>
          </div>
        </div>
      )
    }

    {/* Certification — stated exactly, per guidelines p.9. */}
    <div class="mt-20 border border-hairline bg-gold-wash p-8">
      <p class="eyebrow text-gold-deep">{d.common.certification}</p>
      <p class="body-copy mt-3 text-ink">{d.certification}</p>
      <a href={localePath(locale, '/quote')} class="btn-outline bx-press mt-7"
        >{d.common.askAboutLine}</a
      >
    </div>
  </section>
</Base>
