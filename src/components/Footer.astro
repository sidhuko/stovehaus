---
import LanguageSelector from './LanguageSelector.astro';
import { NAV, SITE, BUILT_BY, whatsappUrl } from '../data/site';
import { t, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  route?: string;
}
const { locale, route = '/' } = Astro.props;
const d = t(locale);
---

{/*
  The tagline signs off here and nowhere else. It never appears in the hero,
  is never modified, and is NEVER translated — the guidelines are explicit on
  that last point. It lives inside the reversed lockup as outlined artwork, so
  there is no live type to translate even by accident.
*/}
<footer class="on-firebox bg-firebox text-surface-100 mt-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
    <div class="grid gap-12 md:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        {/*
          Minimum size for the full lockup WITH the tagline is 200px
          (guidelines p.4) — below that the tagline closes up and stops
          reading. The artwork is 592 × 354, so 224px wide gives 134px tall and
          clears the minimum with room.

          Clear space is X on all four sides, X = the cap height of the
          wordmark. At this size the S measures ~33px, so 33px is held around
          the artwork and nothing enters it.
        */}
        <div class="p-8.25 -m-8.25 inline-block">
          <img
            src="/brand/stovehaus-reversed.svg"
            alt={`${SITE.name} — ${SITE.tagline}`}
            width="224"
            height="134"
            class="w-56 h-auto"
          />
        </div>
        <p class="body-copy mt-8 text-surface-100/75">{d.siteDescription}</p>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 md:gap-16">
        <nav aria-label="Footer">
          <h2 class="eyebrow text-surface-100/55">{d.common.catalogue}</h2>
          <ul class="mt-5 space-y-2.5">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={localePath(locale, item.href)}
                    class="body-copy text-surface-100/80 hover:text-surface-100"
                  >
                    {d.nav[item.key]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <h2 class="eyebrow text-surface-100/55">{d.common.contact}</h2>
          <ul class="mt-5 space-y-2.5">
            <li>
              <a
                href={`tel:${SITE.phoneHref}`}
                class="spec text-surface-100/80 hover:text-surface-100">{SITE.phone}</a
              >
            </li>
            <li>
              <a
                href={whatsappUrl()}
                target="_blank"
                rel="noopener"
                class="body-copy text-surface-100/80 hover:text-surface-100">{d.whatsapp.label}</a
              >
            </li>
            <li>
              <a
                href={`mailto:${SITE.email}`}
                class="body-copy text-surface-100/80 hover:text-surface-100">{SITE.email}</a
              >
            </li>
            <li class="body-copy text-surface-100/60">{SITE.domain}</li>
          </ul>
          <a
            href={localePath(locale, '/quote')}
            class="btn-outline btn-outline-reversed bx-press mt-7">{d.common.requestQuote}</a
          >
        </div>
      </div>
    </div>

    <div
      class="mt-16 pt-8 border-t border-surface-100/15 flex flex-wrap items-center justify-between gap-4"
    >
      <p class="spec text-surface-100/50">
        {d.common.madeInMexico} · {d.common.exportedTo}
      </p>
      <div class="flex items-center gap-5">
        {/* A reader who landed mid-site in the wrong language needs this here too. */}
        <LanguageSelector
          locale={locale}
          route={route}
          class="border-surface-100/30 text-surface-100/70 hover:text-surface-100 hover:border-surface-100/60"
        />
        <p class="spec text-surface-100/50">© {new Date().getFullYear()} {SITE.name}</p>
        {/* Agency credit. Quiet by design — it sits in the same muted register
            as the copyright rather than competing with anything above it. */}
        <p class="spec text-surface-100/50">
          {d.common.builtBy}{' '}
          <a
            href={BUILT_BY.url}
            target="_blank"
            rel="noopener"
            class="underline underline-offset-2 hover:text-surface-100">{BUILT_BY.name}</a
          >
        </p>
      </div>
    </div>
  </div>
</footer>
