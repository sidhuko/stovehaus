---
import { NAV, SITE } from '../data/site';
---

{/*
  The tagline signs off here and nowhere else. It never appears in the hero,
  is never modified and is never translated in the lockup (guidelines p.8).
  Reversed ground, so the reversed lockup artwork is the correct variant.
*/}
<footer class="on-firebox bg-firebox text-surface-100 mt-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
    <div class="grid gap-12 md:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        {/*
          Minimum size for the full lockup WITH the tagline is 200px
          (guidelines p.4) — below that the tagline closes up and stops
          reading. The artwork is 592 × 354, so 224px wide gives 134px tall and
          clears the minimum with room.

          Clear space is X on all four sides, X = the cap height of the
          wordmark. At this size the S measures ~33px, so 33px is held around
          the artwork and nothing enters it.

          The lockup carries the tagline, so this IS the footer sign-off —
          "Built for the flame." is not repeated as live type below.
        */}
        <div class="p-8.25 -m-8.25 inline-block">
          <img
            src="/brand/stovehaus-reversed.svg"
            alt={`${SITE.name} — ${SITE.tagline}`}
            width="224"
            height="134"
            class="w-56 h-auto"
          />
        </div>
        <p class="body-copy mt-8 text-surface-100/75">
          Wood-fired sauna and jacuzzi heaters and gas fire pits, hand-welded in Mexico and
          shipped north.
        </p>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 md:gap-16">
        <nav aria-label="Footer">
          <h2 class="eyebrow text-surface-100/55">Catalogue</h2>
          <ul class="mt-5 space-y-2.5">
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} class="body-copy text-surface-100/80 hover:text-surface-100">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <h2 class="eyebrow text-surface-100/55">Contact</h2>
          <ul class="mt-5 space-y-2.5">
            <li>
              <a href={`tel:${SITE.phoneHref}`} class="spec text-surface-100/80 hover:text-surface-100"
                >{SITE.phone}</a
              >
            </li>
            <li>
              <a href={`mailto:${SITE.email}`} class="body-copy text-surface-100/80 hover:text-surface-100"
                >{SITE.email}</a
              >
            </li>
            <li class="body-copy text-surface-100/60">{SITE.domain}</li>
          </ul>
          <a href="/quote" class="btn-outline btn-outline-reversed mt-7">Request a quote</a>
        </div>
      </div>
    </div>

    {/*
      No tagline here. It is already set, as approved artwork at legal size, in
      the lockup above — setting it again as live type would both repeat the
      sign-off and re-typeset a fixed piece of the master file.
    */}
    <div class="mt-16 pt-8 border-t border-surface-100/15 flex flex-wrap items-baseline justify-between gap-4">
      <p class="spec text-surface-100/50">
        Made in Mexico · Exported to the United States and Canada
      </p>
      <p class="spec text-surface-100/50">
        © {new Date().getFullYear()} {SITE.name}
      </p>
    </div>
  </div>
</footer>
