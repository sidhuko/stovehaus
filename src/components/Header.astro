---
import LanguageSelector from './LanguageSelector.astro';
import { NAV, SITE } from '../data/site';
import { t, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** This page's own route — what the language switcher must target. */
  route: string;
  /** Which nav item to mark active. A product page highlights its line. */
  navRoute: string;
}
const { locale, route, navRoute } = Astro.props;
const d = t(locale);

const isActive = (href: string) => navRoute === href || navRoute.startsWith(href + '/');
---

{/*
  Guidelines p.10: "Mark at 32 px beside the wordmark artwork — never the
  stacked lockup, which dies at header height. Active nav takes a 2 px gold
  underline. One gold button, ink label."

  Both marks are the supplied artwork, scaled proportionally. The lockup is
  never rebuilt from live type — README rule 5. It is also never translated:
  the wordmark is outlined artwork, so "Stovehaus" reads identically in both
  languages, which is exactly what the guidelines want.
*/}
<header class="bg-surface-200 border-b border-hairline">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="flex items-center justify-between gap-8 h-[88px]">
      <a
        href={localePath(locale, '/')}
        class="flex items-center gap-3 shrink-0"
        aria-label={`${SITE.name} — ${d.common.breadcrumbHome}`}
      >
        <img
          src="/brand/stovehaus-mark-gold.svg"
          alt=""
          width="47"
          height="32"
          class="h-8 w-auto"
        />
        <img
          src="/brand/stovehaus-wordmark-black.svg"
          alt={SITE.name}
          width="150"
          height="22"
          class="h-[22px] w-auto"
        />
      </a>

      <nav aria-label="Primary" class="hidden lg:block">
        <ul class="flex items-center gap-7">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={localePath(locale, item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'label inline-block pb-1 border-b-2 transition-colors',
                    isActive(item.href)
                      ? 'border-crown-gold text-ink'
                      : 'border-transparent text-ink-muted hover:text-ink',
                  ]}
                >
                  {d.nav[item.key]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden sm:flex items-center gap-3 shrink-0">
        <LanguageSelector locale={locale} route={route} />
        <a href={localePath(locale, '/quote')} class="btn-gold bx-press bx-liquid"
          >{d.common.requestQuote}</a
        >
      </div>
    </div>

    {/* Mobile nav — same items, no second gold element. */}
    <nav aria-label="Primary, mobile" class="lg:hidden border-t border-hairline">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 py-3">
        {
          NAV.map((item) => (
            <li>
              <a
                href={localePath(locale, item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'label inline-block pb-1 border-b-2',
                  isActive(item.href)
                    ? 'border-crown-gold text-ink'
                    : 'border-transparent text-ink-muted',
                ]}
              >
                {d.nav[item.key]}
              </a>
            </li>
          ))
        }
        <li class="sm:hidden">
          <a
            href={localePath(locale, '/quote')}
            class="label inline-block pb-1 border-b-2 border-transparent text-ink"
            >{d.common.requestQuote}</a
          >
        </li>
        <li class="ml-auto">
          <LanguageSelector locale={locale} route={route} />
        </li>
      </ul>
    </nav>
  </div>
</header>
